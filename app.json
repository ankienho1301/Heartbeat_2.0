{
  "expo": {
    "name": "akqt",
    "slug": "akqt",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon_akqt.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ankienho.akqt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ankienho.akqt",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon_akqt.png",
        "backgroundImage": "./assets/icon_2_akqt.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "fc1ddfea-f812-46df-ba49-2d707a65a0af"
      }
    },
    "owner": "ankienho"
  }
}
